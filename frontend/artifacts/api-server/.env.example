# ============================================================
# DermaCheck API Server — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB Atlas (free M0 tier — https://mongodb.com/atlas) ---
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-user:your-password@cluster0.xxxxx.mongodb.net/dermacheck?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=replace-this-with-a-long-random-secret-string

# --- Google AI Studio (Gemini 2.5 Flash) ---
# https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIza...

# --- Groq (Llama 3.3 70B — Care Card generation) ---
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...
